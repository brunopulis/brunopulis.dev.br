---
layout: base.njk
permalink: '/en/services/'
title: 'Services'
description: 'I help organizations make their websites and digital services accessible to people with disabilities and better for everyone.'
---

{% from "partials/service-card.njk" import serviceCard %}

<section class="page-content">
  <div class="mx-auto px-8 max-w-7xl">
    <h1 class="text-blood-red-950">{{ 'pages.services.index.title' | i18n(locale) }}</h1>
    <p class="lead">
      {{ 'pages.services.index.description' | i18n(locale) }}
    </p>
    <p class="lead">
      {{ 'pages.services.index.lead' | i18n(locale) }}<a href="/en/services/accessibility-audit" class="hover:text-blood-red-950 underline underline-offset-4 hover:no-underline">{{ 'pages.services.index.auditLink' | i18n(locale) }}</a>{{ 'pages.services.index.and' | i18n(locale) }}<a href="/en/services/accessible-sites" class="hover:text-blood-red-950 underline underline-offset-4 hover:no-underline">{{ 'pages.services.index.devLink' | i18n(locale) }}</a>.
    </p>

    <div class="gap-6 grid md:grid-cols-2 lg:grid-cols-3 my-12">
      {% for service in 'services' | i18n(locale) %}
        {{ serviceCard(service, locale) }}
      {% endfor %}
    </div>
  </div>
</section>

<section class="bg-light-silver-100 py-24">
  <div class="flex md:flex-row flex-col justify-between items-center gap-12 mx-auto px-8 max-w-7xl">
    <div class="max-w-2xl">
      <h2 class="mb-4 font-black text-blood-red-950 text-4xl">{{ 'pages.services.index.ctaTitle' | i18n(locale) }}</h2>
      <p class="text-secondary text-lg">{{ 'pages.services.index.ctaText' | i18n(locale) }}</p>
    </div>
    <a href="/en/contact"
      class="bg-blood-red-950 px-12 py-5 rounded font-bold text-on-primary text-white text-lg hover:scale-[1.02] active:scale-95 transition-all">
      {{ 'pages.services.index.ctaButton' | i18n(locale) }}
    </a>
  </div>
</section>
