---
layout: base.njk
permalink: '/en/privacy/'
title: 'Privacy Policy'
description: 'Learn how we collect, use, and protect your personal data in compliance with the Brazilian General Data Protection Law (LGPD).'
---

<section class="page-content">
  <div class="mx-auto px-8 max-w-7xl">
    <h1>{{ 'pages.privacy.title' | i18n(locale) }}</h1>
    <p class="lead">{{ 'pages.privacy.description' | i18n(locale) }}</p>

    {% for section in 'pages.privacy.sections' | i18n(locale) %}
    <h2>{{ section.heading }}</h2>
    {% if section.text %}<p>{{ section.text }}</p>{% endif %}
    {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}
    {% if section.items %}
    <ul>
      {% for item in section.items %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% endfor %}

    <p><em>{{ 'pages.privacy.lastUpdate' | i18n(locale) }}</em></p>
  </div>
</section>
