---
layout: base.njk
permalink: '/en/talks/'
title: 'Talks'
description: 'Talks and presentations on digital accessibility, inclusive design, and accessible web development.'
---

<section class="page-content">
  <div class="mx-auto px-8 max-w-7xl">
    <h1>{{ 'pages.talks.title' | i18n(locale) }}</h1>
    <p class="lead">
      {{ 'pages.talks.description' | i18n(locale) }}
    </p>

    <div class="talks-list">
      {% for talk in 'pages.talks.talks' | i18n(locale) %}
      <article class="mb-4 talk-card">
        <span class="talk-type">{{ talk.type }}</span>
        <h2>{{ talk.title }}</h2>
        <p>{{ talk.description }}</p>
        <a href="#" class="btn-link">{{ 'pages.talks.link' | i18n(locale) }}</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
