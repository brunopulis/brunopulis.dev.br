---
layout: base.njk
permalink: '/en/accessibility/'
title: 'Accessibility Statement'
description: 'Commitment to digital inclusion and compliance with web accessibility guidelines.'
---

<section class="page-content prose">
  <div class="mx-auto px-8 max-w-7xl">
    <h1 class="font-bold text-blood-red-950">{{ 'pages.accessibility.title' | i18n(locale) }}</h1>
    <p class="lead">{{ 'pages.accessibility.description' | i18n(locale) }}</p>

    {% for section in 'pages.accessibility.sections' | i18n(locale) %}
    <h2 class="font-bold">{{ section.heading }}</h2>
    <p>{{ section.text }}</p>
    {% if section.items %}
    <ul class="list-disc">
      {% for item in section.items %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if section.contact %}
    <p>{{ section.contact }}</p>
    {% endif %}
    {% endfor %}

    <p><em>{{ 'pages.accessibility.lastUpdate' | i18n(locale) }}</em></p>
  </div>
</section>
