---
layout: base.njk
permalink: '/en/portfolio/'
title: 'Portfolio'
description: 'Accessible development projects, consulting, and inclusive interface implementation.'
---

<section class="page-content">
  <div class="mx-auto px-8 max-w-7xl">
    <h1 class="font-bold text-blood-red-950">{{ 'pages.portfolio.title' | i18n(locale) }}</h1>
    <p class="lead">
      {{ 'pages.portfolio.description' | i18n(locale) }}
    </p>

    <div class="portfolio-grid">
      {% for project in 'pages.portfolio.projects' | i18n(locale) %}
      <article class="bg-light-silver-100 project-card">
        <div class="project-image"></div>
        <h2>{{ project.title }}</h2>
        <p>{{ project.description }}</p>
        <a href="#" class="btn-link">{{ project.link }}</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
