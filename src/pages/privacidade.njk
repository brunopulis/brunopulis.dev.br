---
layout: base.njk
permalink: '/privacidade/'
title: 'Política de Privacidade'
description: 'Saiba como coletamos, usamos e protegemos seus dados pessoais em conformidade com a Lei Geral de Proteção de Dados (LGPD).'
---

<section class="region">
  <div class="wrapper">
    <div class="flow prose">
      <h1>{{ 'pages.privacy.title' | i18n(locale) }}</h1>
      <p class="lede">{{ 'pages.privacy.description' | i18n(locale) }}</p>

      {% for section in 'pages.privacy.sections' | i18n(locale) %}
      <h2>{{ section.heading }}</h2>
      {% if section.text %}<p>{{ section.text }}</p>{% endif %}
      {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}
      {% if section.items %}
      <ul>
        {% for item in section.items %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% endfor %}

      <p><em>{{ 'pages.privacy.lastUpdate' | i18n(locale) }}</em></p>
    </div>
  </div>
</section>
