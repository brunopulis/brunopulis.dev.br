---
layout: base.njk
permalink: '/termos/'
title: 'Termos de Uso'
description: 'Condições gerais para navegação e utilização do site Bruno Pulis.'
---

<section class="region">
  <div class="wrapper">
    <div class="flow prose">
      <h1>{{ 'pages.terms.title' | i18n(locale) }}</h1>
      <p class="lede">{{ 'pages.terms.description' | i18n(locale) }}</p>

      {% for section in 'pages.terms.sections' | i18n(locale) %}
      <h2>{{ section.heading }}</h2>
      {% if section.text %}<p>{{ section.text }}</p>{% endif %}
      {% if section.text1 %}<p>{{ section.text1 }}</p>{% endif %}
      {% if section.text2 %}<p>{{ section.text2 }}</p>{% endif %}
      {% endfor %}

      <p><em>{{ 'pages.terms.lastUpdate' | i18n(locale) }}</em></p>
    </div>
  </div>
</section>
