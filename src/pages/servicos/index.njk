---
layout: base.njk
permalink: '/servicos/'
title: 'Serviços'
description: 'Ajudo organizações a tornarem seus sites e serviços digitais acessíveis para pessoas com deficiência e melhores para todos.'
---

{% from "partials/service-card.njk" import serviceCard %}

<section class="region">
  <div class="wrapper">
    <div class="flow prose">
      <h1>{{ 'pages.services.index.title' | i18n(locale) }}</h1>
      <p class="lede">{{ 'pages.services.index.description' | i18n(locale) }}</p>
      <p class="lede">
        {{ 'pages.services.index.lead' | i18n(locale) }}
        <a href="{{ '/en/services/accessibility-audit' if locale === 'en' else '/servicos/auditoria-acessibilidade' }}">{{ 'pages.services.index.auditLink' | i18n(locale) }}</a>{{ 'pages.services.index.and' | i18n(locale) }}
        <a href="{{ '/en/services/accessible-sites' if locale === 'en' else '/servicos/sites-acessiveis' }}">{{ 'pages.services.index.devLink' | i18n(locale) }}</a>.
      </p>
    </div>
    <div class="grid">
      {% for service in 'services' | i18n(locale) %}
        {{ serviceCard(service, locale, 'h2') }}
      {% endfor %}
    </div>
  </div>
</section>

<section class="cta-inline region">
  <div class="wrapper repel">
    <div class="flow">
      <h2 class="cta-inline__title">{{ 'pages.services.index.ctaTitle' | i18n(locale) }}</h2>
      <p class="cta-inline__text">{{ 'pages.services.index.ctaText' | i18n(locale) }}</p>
    </div>
    <a class="button" href="{{ '/en/contact' if locale === 'en' else '/contato' }}">
      {{ 'pages.services.index.ctaLink' | i18n(locale) }}
    </a>
  </div>
</section>
