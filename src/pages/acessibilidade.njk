---
layout: base.njk
permalink: '/acessibilidade/'
title: 'Declaração de Acessibilidade'
description: 'Compromisso com a inclusão digital e conformidade com as diretrizes de acessibilidade para a web.'
---

<section class="region">
  <div class="wrapper">
    <div class="flow prose">
      <h1>{{ 'pages.accessibility.title' | i18n(locale) }}</h1>
      <p class="lede">{{ 'pages.accessibility.description' | i18n(locale) }}</p>

      {% for section in 'pages.accessibility.sections' | i18n(locale) %}
      <h2>{{ section.heading }}</h2>
      <p>{{ section.text }}</p>
      {% if section.items %}
      <ul>
        {% for item in section.items %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if section.contact %}
      <p>{{ section.contact }}</p>
      {% endif %}
      {% endfor %}

      <p><em>{{ 'pages.accessibility.lastUpdate' | i18n(locale) }}</em></p>
    </div>
  </div>
</section>
