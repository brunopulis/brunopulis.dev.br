---
layout: base.njk
permalink: '/palestras/'
title: 'Palestras'
description: 'Palestras e apresentações sobre acessibilidade digital, design inclusivo e desenvolvimento web acessível.'
---

<section class="region">
  <div class="wrapper">
    <div class="flow prose">
      <h1>{{ 'pages.talks.title' | i18n(locale) }}</h1>
      <p class="lede">{{ 'pages.talks.description' | i18n(locale) }}</p>
    </div>
    <ol class="talks grid" role="list">
      {% for talk in 'pages.talks.talks' | i18n(locale) %}
      <li class="talk">
        <p class="eyebrow eyebrow--sm">{{ talk.type }}</p>
        <h2 class="talk__title">{{ talk.title }}</h2>
        <p class="talk__text">{{ talk.description }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
