<section class="about region" aria-labelledby="about-title">
  <div class="wrapper">
    <div class="grid about__grid" data-layout="50-50">
      <div class="about__intro flow">
        <p class="eyebrow">{{ 'about.eyebrow' | i18n(locale) }}</p>
        <h2 class="about__title" id="about-title">
          {{ 'about.title' | i18n(locale) }}<span class="display-accent">{{ 'about.titleItalic' | i18n(locale) }}</span>
        </h2>
        <p class="about__text">{{ 'about.text' | i18n(locale) | safe }}</p>
      </div>
      <ul class="stats" role="list">
        {% for stat in ['experience', 'projects', 'focus', 'standard'] %}
        <li class="stat">
          <p class="stat__value">{{ ('about.stats.' + stat + '.value') | i18n(locale) }}</p>
          <p class="stat__label">{{ ('about.stats.' + stat + '.label') | i18n(locale) }}</p>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
