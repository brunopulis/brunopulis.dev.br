<section class="hero region" aria-labelledby="hero-title">
  <div class="wrapper">
    <div class="grid hero__grid" data-layout="50-50">
      <div class="hero__intro flow">
        <p class="eyebrow">{{ 'hero.eyebrow' | i18n(locale) }}</p>
        <h1 class="hero__title" id="hero-title">
          {{ 'hero.title' | i18n(locale) }}<span class="display-accent">{{ 'hero.titleItalic' | i18n(locale) }}</span>
        </h1>
        <p class="hero__subtitle">{{ 'hero.subtitle' | i18n(locale) }}</p>
        <div class="hero__actions cluster">
          <a class="button" href="{{ '/en/services' if locale === 'en' else '/servicos' }}">
            {{ 'hero.ctaServices' | i18n(locale) }}
          </a>
          <a class="button" data-variant="outline" href="{{ '/en/contact' if locale === 'en' else '/contato' }}">
            {{ 'hero.ctaContact' | i18n(locale) }}
          </a>
        </div>
      </div>
      <div class="hero__media">
        <figure class="hero__media-figure">
          <img src="/assets/images/pulis.webp" alt="{{ 'hero.imgAlt' | i18n(locale) }}" width="1418" height="1600">
        </figure>
      </div>
    </div>
  </div>
</section>
