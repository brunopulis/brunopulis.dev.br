<section class="relative flex items-center bg-light-silver-50 px-8 py-20 overflow-hidden">
  <div class="items-center gap-16 grid md:grid-cols-2 mx-auto mb-12 px-8 max-w-7xl">
    <div class="space-y-8">
      <span class="font-bold text-vista-blue-800 text-sm uppercase tracking-[0.15em]">{{ 'hero.eyebrow' | i18n(locale) }}</span>
      <h1 class="text-5xl md:text-7xl leading-tight">
        {{ 'hero.title' | i18n(locale) }}<span class="text-blood-red-950 italic">{{ 'hero.titleItalic' | i18n(locale) }}</span>
      </h1>
      <p class="max-w-2xl text-xl md:text-2xl leading-relaxed">
        {{ 'hero.subtitle' | i18n(locale) }}
      </p>
      <div class="flex flex-wrap gap-4 pt-4">
        <a
          href="{{ '/en/services' if locale === 'en' else '/servicos' }}"
          class="focus:ring-2 focus:ring-errie-black-950 focus:ring-offset-4 font-bold text-blood-red-950 underline underline-offset-4">
          {{ 'hero.ctaServices' | i18n(locale) }}
        </a>
        <a
          href="{{ '/en/contact' if locale === 'en' else '/contato' }}"
          class="focus:ring-2 focus:ring-errie-black-950 focus:ring-offset-4 font-bold text-blood-red-950 underline underline-offset-4">
          {{ 'hero.ctaContact' | i18n(locale) }}
        </a>
      </div>
    </div>
    <div class="flex justify-center items-center">
      <img src="/assets/images/pulis.webp" alt="{{ 'hero.imgAlt' | i18n(locale) }}" class="shadow-lg rounded-2xl w-full max-w-md h-auto object-cover">
    </div>
  </div>
</section>
