<section class="portfolio region" aria-labelledby="portfolio-title">
  <div class="wrapper">
    <div class="repel">
      <div class="portfolio__head flow">
        <p class="eyebrow">{{ 'portfolioSection.eyebrow' | i18n(locale) }}</p>
        <h2 class="portfolio__title" id="portfolio-title">
          {{ 'portfolioSection.title' | i18n(locale) }}<span class="display-accent">{{ 'portfolioSection.titleItalic' | i18n(locale) }}</span>
        </h2>
      </div>
      <a class="button" data-variant="outline" href="{{ '/en/portfolio' if locale === 'en' else '/portfolio' }}">
        {{ 'portfolioSection.cta' | i18n(locale) }}
      </a>
    </div>
    <ul class="portfolio__list grid" role="list">
      {% for project in 'portfolioSection.projects' | i18n(locale) %}
      <li class="card portfolio__card">
        <div class="flow">
          <p class="eyebrow eyebrow--sm">{{ project.category }}</p>
          <h3 class="portfolio__card-title">
            <a href="{{ project.url }}" target="_blank" rel="noopener noreferrer">{{ project.name }}</a>
          </h3>
          <p class="portfolio__card-text">{{ project.description }}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
