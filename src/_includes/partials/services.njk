<section class="services region" aria-labelledby="services-title">
  <div class="wrapper">
    <h2 class="services__title" id="services-title">{{ 'servicesSection.title' | i18n(locale) }}</h2>
    <ul class="services__list grid" role="list">
      {% for item in 'servicesSection.items' | i18n(locale) %}
      <li class="service">
        <h3 class="service__title">{{ item.title }}</h3>
        <p class="service__text">{{ item.description }}</p>
      </li>
      {% endfor %}
    </ul>
    <p class="services__cta">
      <a class="button" data-variant="outline" href="{{ '/en/services' if locale === 'en' else '/servicos' }}">
        {{ 'servicesSection.cta' | i18n(locale) }}
      </a>
    </p>
  </div>
</section>
