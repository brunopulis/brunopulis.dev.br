<section class="process region" aria-labelledby="process-title">
  <div class="wrapper">
    <div class="process__head flow text-center">
      <p class="eyebrow">{{ 'process.eyebrow' | i18n(locale) }}</p>
      <h2 class="process__title" id="process-title">{{ 'process.title' | i18n(locale) }}</h2>
    </div>
    <ol class="process__list grid" role="list">
      {% for step in 'process.steps' | i18n(locale) %}
      <li class="process__step flow">
        <p class="process__num">{{ step.phase }}</p>
        <h3 class="process__heading">{{ step.title }}</h3>
        <p>{{ step.description }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
