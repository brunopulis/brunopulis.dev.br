<section class="cta region" aria-labelledby="cta-title">
  <div class="wrapper text-center">
    <div class="flow">
      <p class="eyebrow eyebrow--invert">{{ 'contactSection.eyebrow' | i18n(locale) }}</p>
      <h2 class="cta__title" id="cta-title">
        {{ 'contactSection.title' | i18n(locale) }}<span class="display-accent">{{ 'contactSection.titleItalic' | i18n(locale) }}</span>{{ 'contactSection.titleEnd' | i18n(locale) }}
      </h2>
      <p class="cta__email">
        <a class="cta__email-link" href="mailto:{{ 'contactSection.email' | i18n(locale) }}?subject={{ 'contactSection.mailSubject' | i18n(locale) | urlencode }}">
          {{ 'contactSection.email' | i18n(locale) }}
        </a>
      </p>
    </div>
  </div>
</section>
