<footer class="bg-errie-black-900 px-8 py-12">
  <div class="mx-auto max-w-7xl">
    <div class="justify-between items-center gap-4 grid grid-cols-1 md:grid-cols-2">
      <div>
        <p class="font-serif text-white text-xl italic">{{ 'site.name' | i18n(locale) }}</p>
        <p class="mt-2 font-sans font-light text-white text-xs uppercase tracking-widest">{{ 'site.role' | i18n(locale) }}</p>
      </div>
      <div>
        <h2 class="sr-only">{{ 'footer.institutionalLinks' | i18n(locale) }}</h2>
        <ul class="flex flex-wrap gap-2">
        <li>
          <a href="https://instagram.com/codigoacessivel" class="footer__link" target="_blank" rel="noopener noreferrer me">
            {{ 'footer.instagram' | i18n(locale) }}
          </a>
        </li>
        <li>
          <a href="https://linkedin.com/in/pulis" class="footer__link" target="_blank" rel="noopener noreferrer me">
            {{ 'footer.linkedin' | i18n(locale) }}
          </a>
        </li>
        <li>
          <a href="https://youtube.com/c/BrunoPulis" class="footer__link" target="_blank" rel="noopener noreferrer me">
            {{ 'footer.youtube' | i18n(locale) }}
          </a>
        </li>
      </ul>

      </div>
    </div>

    <nav class="mt-8 pt-8 border-zinc-800 border-t">
      <ul class="flex gap-2">
          <li><a class="footer__link" href="{{ '/en/privacy' if locale === 'en' else '/privacidade' }}">{{ 'footer.privacy' | i18n(locale) }}</a></li>
          <li><a class="footer__link" href="{{ '/en/terms' if locale === 'en' else '/termos' }}">{{ 'footer.terms' | i18n(locale) }}</a></li>
          <li><a class="footer__link" href="{{ '/en/accessibility' if locale === 'en' else '/acessibilidade' }}">{{ 'footer.accessibility' | i18n(locale) }}</a></li>
        </ul>
    </nav>
  </div>
</footer>
