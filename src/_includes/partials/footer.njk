<footer class="site-footer region">
  <div class="wrapper">
    <div class="repel">
      <div class="site-footer__brand">
        <p class="site-footer__name">{{ 'site.name' | i18n(locale) }}</p>
        <p class="site-footer__role">{{ 'site.role' | i18n(locale) }}</p>
      </div>
      <ul class="site-footer__social cluster" role="list">
        <li>
          <a href="https://instagram.com/codigoacessivel" target="_blank" rel="noopener noreferrer me">
            <span class="visually-hidden">{{ 'footer.instagram' | i18n(locale) }}</span>
            <i class="fa-brands fa-instagram" aria-hidden="true"></i>
          </a>
        </li>
        <li>
          <a href="https://linkedin.com/in/pulis" target="_blank" rel="noopener noreferrer me">
            <span class="visually-hidden">{{ 'footer.linkedin' | i18n(locale) }}</span>
            <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
          </a>
        </li>
        <li>
          <a href="https://youtube.com/c/BrunoPulis" target="_blank" rel="noopener noreferrer me">
            <span class="visually-hidden">{{ 'footer.youtube' | i18n(locale) }}</span>
            <i class="fa-brands fa-youtube" aria-hidden="true"></i>
          </a>
        </li>
      </ul>
    </div>
    <nav class="site-footer__legal cluster" aria-label="{{ 'footer.institutionalLinks' | i18n(locale) }}">
      <a href="{{ '/en/privacy' if locale === 'en' else '/privacidade' }}">{{ 'footer.privacy' | i18n(locale) }}</a>
      <a href="{{ '/en/terms' if locale === 'en' else '/termos' }}">{{ 'footer.terms' | i18n(locale) }}</a>
      <a href="{{ '/en/accessibility' if locale === 'en' else '/acessibilidade' }}">{{ 'footer.accessibility' | i18n(locale) }}</a>
    </nav>
  </div>
</footer>
