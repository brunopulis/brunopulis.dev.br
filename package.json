{
  "name": "studio",
  "description": "Site para divulgação dos trabalhos como consultoria de acessibilidade.",
  "version": "1.0.0",
  "author": "Bruno Pulis",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/copy-fonts.js",
    "start": "run-p dev:css dev:eleventy",
    "dev:css": "sass src/assets/scss/main.scss:src/assets/css/index.css --load-path=node_modules --watch --no-source-map",
    "dev:eleventy": "eleventy --serve",
    "prebuild": "node scripts/copy-fonts.js",
    "build": "npm run build:css && eleventy",
    "build:css": "sass src/assets/scss/main.scss:src/assets/css/index.css --load-path=node_modules --style=compressed --no-source-map",
    "clean": "rimraf _site src/assets/css/index.css",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/e2e.js",
    "test:e2e:smoke": "node scripts/e2e.js --spec cypress/e2e/smoke.cy.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/is-land": "^5.0.1",
    "@fontsource/noto-serif": "^5.2.5",
    "@fontsource/source-sans-3": "^5.2.6",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "lite-youtube-embed": "^0.3.4",
    "markdown-it-table-of-contents": "^1.2.0"
  },
  "devDependencies": {
    "@toycode/markdown-it-class": "^1.2.4",
    "cross-env": "^10.1.0",
    "cssnano": "^9.0.1",
    "cypress": "^16.1.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.1",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "luxon": "^3.5.0",
    "markdown-it": "^15.0.1",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-prism": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "prettier-plugin-jinja-template": "^2.1.0",
    "rimraf": "^6.1.3",
    "sanitize-html": "^2.17.7",
    "sass": "^1.103.1",
    "sharp": "^0.35.4",
    "sharp-ico": "^0.1.5",
    "slugify": "^1.6.9",
    "svgo": "^4.1.0",
    "vitest": "^5.0.1"
  }
}
